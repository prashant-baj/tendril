# Tendril — example environment file.
# Copy to `.env` for LOCAL development only. NEVER commit a real `.env`.
# Runtime secrets (API keys, provider tokens) do NOT belong here — they live in
# AWS Secrets Manager / SSM Parameter Store and are read at runtime.

# --- Deployment context (non-secret) ---
ENV_NAME=dev
AWS_REGION=ap-south-1
AWS_PROFILE=tendril-dev

# --- Bedrock (non-secret identifiers) ---
# Set to an inference profile your account is SUBSCRIBED to (AWS Marketplace) and that is
# listed for your region. Mumbai supports both `apac.` and `global.` profiles.
# Using Claude Sonnet 4 (already-subscribed); switch to a `global.` newer model once its
# Marketplace subscription is active.
MODEL_ID=amazon.nova-lite-v1:0

# --- Application config (non-secret) ---
PROMPT_BUCKET=
LOG_LEVEL=INFO

# --- Placeholders for locally-injected secrets (real values come from SSM/Secrets Manager) ---
# WHATSAPP_API_TOKEN=__set_in_secrets_manager__
# WEATHER_API_KEY=__set_in_secrets_manager__
